# Dependencies
node_modules/
venv/
.venv/
__pycache__/
*.pyc

# Build outputs
site/
_site/
/build/
dist/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Environment
.env
.env.local
*.log

# Build cache
.cache/

# Astro
.astro/

# Temporary files
*.tmp
*.temp

# Generated at build time
src/content/docs/courses/builders/lessons/
src/content/docs/courses/leaders/lessons/

# Local drafts and working files
outputs/
specs/

# Registry tooling fixtures deliberately include their own outputs/ trees --
# un-ignore them so they aren't swallowed by the unanchored outputs/ rule
# above, and so `git check-ignore` inside a staged fixture only sees the
# fixture's own .gitignore, not this repo's.
!registry-template/tools/fixtures/**

# The worked-example project folder is a committed fixture with its own outputs/
# tree and composed REGISTRY.md -- un-ignore it the same way as the tooling fixtures.
!examples/weekly-status-report/**
examples/weekly-status-report/registry-dashboard.html
# The negation above also re-admits junk and derived packages -- keep them out.
examples/weekly-status-report/**/.DS_Store
examples/weekly-status-report/**/*.zip

# on-demand docx install by the multi-agent-example renderer
plugins/multi-agent-example/scripts/node_modules/
scripts/node_modules/

# subagent-driven-development scratch (ledgers, briefs, review packages)
.superpowers/
