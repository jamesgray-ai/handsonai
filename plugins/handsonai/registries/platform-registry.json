  "curated-tools": [
    {
      "name": "Google Workspace CLI",
      "type": "cli",
      "url": "https://github.com/googleworkspace/cli",
      "integrations": ["google-calendar", "gmail", "drive", "sheets", "docs"],
      "notes": "Official Google CLI for workspace automation"
    },
    {
      "name": "GitHub CLI",
      "type": "cli",
      "url": "https://cli.github.com",
      "integrations": ["github"],
      "notes": "Official GitHub CLI for repos, PRs, issues, actions"
    },
    {
      "name": "Slack CLI",
      "type": "cli",
      "url": "https://docs.slack.dev/tools/slack-cli",
      "integrations": ["slack"],
      "notes": "Official Slack CLI for workflow automation"
    }
  ],
  "skill-registries": [
    {
      "name": "Agent Skills",
      "type": "web-search",
      "url": "https://agentskills.io",
      "notes": "Open standard for the Skill primitive (used by ChatGPT and other platforms)"
    },
    {
      "name": "skills.sh",
      "type": "web-search",
      "url": "https://skills.sh",
      "notes": "Community skill marketplace"
    },
    {
      "name": "Context7",
      "type": "mcp",
      "tool": "query-docs",
      "notes": "Library docs and skills via MCP"
    }
  ],
  "integration-registries": [
    {
      "name": "Context7",
      "type": "mcp",
      "tool": "query-docs",
