{
  "skill_name": "indexing-registry",
  "how_to_run": "From this folder: python3 ../../framework-evals/run_eval.py <out-dir> <eval-id>... --evals evals.json (runs: 3 each; the indexing-registry student scripts are in framework-evals/students/; dir: fixtures are relative to this folder).",
  "evals": [
    {
      "id": "IR1",
      "name": "stale-tools-update",
      "source": "deconstruct-redesign.md section 5 (Registry tools, R2-3, R3-4); Review Focus 5",
      "fixture": "dir:../../framework-fixtures/seeds/sales-stale-tools",
      "student": "../../framework-evals/students/design-student.md",
      "files": [
        "../../framework-evals/students/design-student.md",
        "../../framework-fixtures/seeds/sales-stale-tools"
      ],
      "sessions": [
        {
          "prompt": "Run the design skill.",
          "student": true
        },
        {
          "prompt": "Update my registry.",
          "student": true
        }
      ],
      "expected_output": "A workspace whose tools/ have no TOOLS_VERSION gets the update offer, through Design's closing maintenance pass and on a direct run; on yes the six files are copied, the dashboard re-templated before composing, and the badge reads right with both Design spec and Design plan links.",
      "preconditions": [
        "When the AI offered to update the registry's tools, the student said yes.",
        "When the AI asked for approval (Design path), the student approved."
      ],
      "expectations": [
        {
          "text": "Design path: the update offer is said word for word",
          "kind": "scripted",
          "check": {
            "type": "ai_contains",
            "text": "Your registry's tools are out of date. Update them now?",
            "session": 1
          },
          "must": true
        },
        {
          "text": "Design path: on yes, the six files (compose-registry.js, lint-registry.js, registry-lib.js, package.json, dashboard-template.html, data-island.schema.json) are copied over `tools/`",
          "kind": "scripted",
          "check": {
            "type": "all",
            "checks": [
              {
                "type": "file_contains",
                "path": "tools/registry-lib.js",
                "text": "TOOLS_VERSION",
                "session": 1
              },
              {
                "type": "file_regex",
                "path": "tools/package.json",
                "pattern": "\"version\"\\s*:",
                "session": 1
              },
              {
                "type": "file_not_contains",
                "path": "tools/compose-registry.js",
                "text": "stale-tools-9.1.0",
                "session": 1
              },
              {
                "type": "file_not_contains",
                "path": "tools/lint-registry.js",
                "text": "stale-tools-9.1.0",
                "session": 1
              },
              {
                "type": "file_not_contains",
                "path": "tools/registry-lib.js",
                "text": "stale-tools-9.1.0",
                "session": 1
              },
              {
                "type": "file_not_contains",
                "path": "tools/dashboard-template.html",
                "text": "stale-template-9.1.0",
                "session": 1
              },
              {
                "type": "file_not_contains",
                "path": "tools/data-island.schema.json",
                "text": "stale-template-9.1.0",
                "session": 1
              }
            ]
          },
          "must": true
        },
        {
          "text": "Design path: `registry-dashboard.html` is re-templated from the new template (the stale page's marker is gone)",
          "kind": "scripted",
          "check": {
            "type": "file_not_contains",
            "path": "registry-dashboard.html",
            "text": "stale-template-9.1.0",
            "session": 1
          },
          "must": true
        },
        {
          "text": "Design path: the Sales Pre-Call Brief badge reads step 3/7 (the new \"Design plan\" link counts)",
          "kind": "scripted",
          "check": {
            "type": "file_regex",
            "path": "REGISTRY.md",
            "pattern": "\\[Sales Pre-Call Brief\\]\\(registry/workflows/sales-pre-call-brief\\.md\\) · step 3/7 done",
            "session": 1
          },
          "must": true
        },
        {
          "text": "Design path: a node with both \"Design spec\" and \"Design plan\" links counts them as one step (5/7, never 6/7)",
          "kind": "scripted",
          "check": {
            "type": "file_regex",
            "path": "REGISTRY.md",
            "pattern": "\\[Client Follow-Up Email\\]\\(registry/workflows/client-follow-up\\.md\\) · step 5/7 done",
            "session": 1
          },
          "must": true
        },
        {
          "text": "Design path: the workspace's `registry/SCHEMA.md` is left as it is",
          "kind": "scripted",
          "check": {
            "type": "file_unchanged",
            "path": "registry/SCHEMA.md",
            "session": 1
          }
        },
        {
          "text": "direct run: the update offer is said word for word",
          "kind": "scripted",
          "check": {
            "type": "ai_contains",
            "text": "Your registry's tools are out of date. Update them now?",
            "session": 2
          },
          "must": true
        },
        {
          "text": "direct run: on yes, the six files (compose-registry.js, lint-registry.js, registry-lib.js, package.json, dashboard-template.html, data-island.schema.json) are copied over `tools/`",
          "kind": "scripted",
          "check": {
            "type": "all",
            "checks": [
              {
                "type": "file_contains",
                "path": "tools/registry-lib.js",
                "text": "TOOLS_VERSION",
                "session": 2
              },
              {
                "type": "file_regex",
                "path": "tools/package.json",
                "pattern": "\"version\"\\s*:",
                "session": 2
              },
              {
                "type": "file_not_contains",
                "path": "tools/compose-registry.js",
                "text": "stale-tools-9.1.0",
                "session": 2
              },
              {
                "type": "file_not_contains",
                "path": "tools/lint-registry.js",
                "text": "stale-tools-9.1.0",
                "session": 2
              },
              {
                "type": "file_not_contains",
                "path": "tools/registry-lib.js",
                "text": "stale-tools-9.1.0",
                "session": 2
              },
              {
                "type": "file_not_contains",
                "path": "tools/dashboard-template.html",
                "text": "stale-template-9.1.0",
                "session": 2
              },
              {
                "type": "file_not_contains",
                "path": "tools/data-island.schema.json",
                "text": "stale-template-9.1.0",
                "session": 2
              }
            ]
          },
          "must": true
        },
        {
          "text": "direct run: `registry-dashboard.html` is re-templated from the new template (the stale page's marker is gone)",
          "kind": "scripted",
          "check": {
            "type": "file_not_contains",
            "path": "registry-dashboard.html",
            "text": "stale-template-9.1.0",
            "session": 2
          },
          "must": true
        },
        {
          "text": "direct run: the Sales Pre-Call Brief badge reads step 2/7",
          "kind": "scripted",
          "check": {
            "type": "file_regex",
            "path": "REGISTRY.md",
            "pattern": "\\[Sales Pre-Call Brief\\]\\(registry/workflows/sales-pre-call-brief\\.md\\) · step 2/7 done",
            "session": 2
          },
          "must": true
        },
        {
          "text": "direct run: a node with both \"Design spec\" and \"Design plan\" links counts them as one step (5/7, never 6/7)",
          "kind": "scripted",
          "check": {
            "type": "file_regex",
            "path": "REGISTRY.md",
            "pattern": "\\[Client Follow-Up Email\\]\\(registry/workflows/client-follow-up\\.md\\) · step 5/7 done",
            "session": 2
          },
          "must": true
        },
        {
          "text": "direct run: the workspace's `registry/SCHEMA.md` is left as it is",
          "kind": "scripted",
          "check": {
            "type": "file_unchanged",
            "path": "registry/SCHEMA.md",
            "session": 2
          }
        },
        {
          "text": "Design path: the plan is approved",
          "kind": "scripted",
          "check": {
            "type": "file_regex",
            "path": "framework/sales-pre-call-brief/design-plan.md",
            "pattern": "^approved: true\\s*$",
            "session": 1
          }
        },
        {
          "text": "Design path: the offer comes from the maintenance pass at the end of Design, after approval, in plain words; Design's close still names Build as the next step",
          "kind": "judged",
          "must": true
        },
        {
          "text": "Both sessions: the dashboard is re-templated before compose runs (compose only injects data into an existing page), and the student is never asked to edit or copy the files by hand",
          "kind": "judged",
          "must": true
        }
      ],
      "runs": 3
    }
  ]
