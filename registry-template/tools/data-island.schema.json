{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://handsonai.info/registry-template/data-island.schema.json",
  "title": "OKF Registry Data Island",
  "description": "The shape of the JSON data island emitted by registry-template/tools/compose-registry.js (--island-only or embedded in the dashboard HTML). Consumers (the dashboard, the MCP/skill query tools) tolerate unknown keys -- additionalProperties is true everywhere on purpose (OKF doctrine: readers must not break on forward-compatible fields).",
  "$comment": "No $ref/definitions anywhere in this schema, by design: the validator embedded in scripts/test-compose-registry.sh is a deliberately zero-dependency ~30-line node -e checker (no ajv, no npm installs) that walks required/type/enum directly off each schema node -- it does not resolve $ref. Every enum (status, definitionType, executionMode, autonomy) is therefore inlined at its property site rather than centralized in a definitions block, so the checker actually sees and enforces it instead of silently no-oping on an unresolved $ref object.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "business",
    "lobs",
    "functions",
    "processes",
    "workflows",
    "notes",
    "skills",
    "agents"
  ],
  "properties": {
    "business": {
      "description": "Single Business node, or null when the bundle has no business file yet (e.g. a fresh skeleton).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "incubating",
            "dormant"
          ]
        },
        "nodePath": {
          "type": "string"
        },
        "nodeUrl": {
          "type": "string"
        }
      }
    },
    "lobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "incubating",
              "dormant"
            ]
          },
          "folder": {
            "type": "string"
          },
          "processes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nodePath": {
            "type": "string"
          },
          "nodeUrl": {
            "type": "string"
          }
        }
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "lead": {
            "type": "string"
          },
          "owns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nodePath": {
            "type": "string"
          },
          "nodeUrl": {
            "type": "string"
          }
        }
      }
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "ownerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "lobId": {
            "type": [
              "string",
              "null"
            ]
          },
          "guide": {
            "type": "string"
          },
          "workflows": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nodePath": {
            "type": "string"
          },
          "nodeUrl": {
            "type": "string"
          }
        }
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "backlog",
              "under-development",
              "in-production",
              "retired"
            ]
          },
          "definitionType": {
            "type": "string",
            "enum": [
              "step-driven",
              "goal-driven",
              "step-decomposed",
              "outcome-driven"
            ]
          },
          "executionMode": {
            "type": "string",
            "enum": [
              "manual",
              "augmented",
              "automated"
            ]
          },
          "autonomy": {
            "type": "string",
            "enum": [
              "deterministic",
              "guided",
              "autonomous"
            ]
          },
          "trigger": {
            "type": "string"
          },
          "staleAfter": {
            "type": "string"
          },
          "processId": {
            "type": [
              "string",
              "null"
            ]
          },
          "lobId": {
            "type": [
              "string",
              "null"
            ]
          },
          "step": {
            "type": [
              "number",
              "null"
            ]
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nodePath": {
            "type": "string"
          },
          "nodeUrl": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nodePath": {
            "type": "string"
          },
          "nodeUrl": {
            "type": "string"
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "usedBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quickStartPrompt": {
            "type": "string"
          },
          "nodePath": {
            "type": "string"
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "usedBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quickStartPrompt": {
            "type": "string"
          },
          "nodePath": {
            "type": "string"
          }
        }
      }
    }
  }
}
